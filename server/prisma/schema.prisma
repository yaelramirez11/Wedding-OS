generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int                   @id @default(autoincrement())
  email                String                @unique
  password             String
  name                 String
  createdAt            DateTime              @default(now())
  guests               Guest[]
  budgetItems          BudgetItem[]
  honeymoonItems       HoneymoonItem[]
  timelineItems        TimelineItem[]
  dashboardCards       DashboardCard[]
  dashboardTasks       DashboardTask[]
  weddingTables        WeddingTable[]
  passwordResetTokens  PasswordResetToken[]
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum GuestStatus {
  pending
  confirmed
  declined
  maybe
}

enum GuestSide {
  bride
  groom
  both
}

model Guest {
  id             Int           @id @default(autoincrement())
  name           String
  status         GuestStatus   @default(pending)
  side           GuestSide     @default(both)
  plusOneAllowed Boolean       @default(false)
  notes          String?
  createdAt      DateTime      @default(now())
  tableId        Int?
  seatIndex      Int?
  table          WeddingTable? @relation(fields: [tableId], references: [id])
  userId         Int?
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum BudgetStatus {
  pending
  advancePayment
  paid
}

enum BudgetCategory {
  venue
  photography
  dress
  honeymoon
  decoration
  chorus
  getReadyBride
  cake
  snacks
  sweets
  waiterTips
  tableNumbers
  alcohol
  favors
  centerpieces
  florals
  sweetheartTable
  other
}

model BudgetItem {
  id          Int            @id @default(autoincrement())
  title       String
  cost        Float
  advancePaid Float          @default(0)
  category    BudgetCategory @default(other)
  subcategory String?
  status      BudgetStatus   @default(pending)
  notes       String?
  createdAt   DateTime       @default(now())
  userId      Int?
  user        User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum HoneymoonCategory {
  hotel
  flight
  transportation
  activities
  food
  documents
  shopping
  other
}

enum HoneymoonStatus {
  planned
  notPlanned
  booked
  paid
  advancePaid
}

model HoneymoonItem {
  id          Int               @id @default(autoincrement())
  title       String
  category    HoneymoonCategory @default(other)
  cost        Float             @default(0)
  advancePaid Float             @default(0)
  status      HoneymoonStatus   @default(planned)
  date        DateTime?
  notes       String?
  createdAt   DateTime          @default(now())
  userId      Int?
  user        User?             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum TimelineType {
  planning
  weddingDay
  honeymoon
}

enum TimelineStatus {
  pending
  inProgress
  completed
  cancelled
}

enum TimelinePriority {
  low
  medium
  high
}

model TimelineItem {
  id        Int              @id @default(autoincrement())
  title     String
  type      TimelineType     @default(planning)
  category  String           @default("general")
  status    TimelineStatus   @default(pending)
  priority  TimelinePriority @default(medium)
  date      DateTime?
  time      String?
  notes     String?
  order     Int              @default(0)
  isCurrent Boolean          @default(false)
  createdAt DateTime         @default(now())
  userId    Int?
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum DashboardStatus {
  Live
  InProgress
  Next
  Done
}

model DashboardCard {
  id        Int             @id @default(autoincrement())
  key       String
  title     String
  status    DashboardStatus @default(Next)
  text      String
  accent    String
  icon      String
  path      String?
  order     Int             @default(0)
  createdAt DateTime        @default(now())
  userId    Int?
  user      User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}

model DashboardTask {
  id        Int             @id @default(autoincrement())
  title     String
  desc      String?
  status    DashboardStatus @default(Next)
  order     Int             @default(0)
  createdAt DateTime        @default(now())
  userId    Int?
  user      User?           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WeddingTable {
  id        Int      @id @default(autoincrement())
  name      String
  label     String?
  order     Int      @default(0)
  capacity  Int      @default(10)
  createdAt DateTime @default(now())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guests    Guest[]

  @@index([userId])
}
